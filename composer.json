{
    "name": "koh/semantic-delivery",
    "description": "Multi-channel content delivery and distribution for TYPO3 — Markdown/AI-Agent/Voice channel negotiation, Distribution adapters for LinkedIn, X, Bluesky, Facebook, Instagram, Dev.to, Buffer, Ayrshare, n8n. Consumes Schema.org via koh/structured-content.",
    "type": "typo3-cms-extension",
    "license": "MIT",
    "homepage": "https://ole-hartwig.eu/open-source/semantic-delivery",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu",
            "homepage": "https://ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/semantic-delivery/issues",
        "source": "https://github.com/ohartwig/semantic-delivery",
        "security": "https://github.com/ohartwig/semantic-delivery/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.5.11",
        "koh/structured-content": "^2.14",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-core": "^14.0",
        "typo3/cms-frontend": "^14.0"
    },
    "require-dev": {
        "koh/dev-typo3": "^1.0"
    },
    "suggest": {
        "koh/content-intelligence": "Required for AI-powered social media content transformation"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "hn/typo3-mcp-server",
                "netresearch/nr-passkeys-be"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Koh\\SemanticDelivery\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SemanticDelivery\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "semantic_delivery"
        }
    },
    "scripts": {
        "deptrac": "deptrac analyse",
        "phpstan": "phpstan analyse",
        "test": "phpunit -c Tests/phpunit.xml --testsuite Unit",
        "test:functional": "phpunit -c Tests/phpunit.xml --testsuite Functional"
    }
}
